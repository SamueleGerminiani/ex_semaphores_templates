
CFLAGS=-Wall -std=gnu99
INCLUDES=-I./inc

PIPELINE_SRCS=src/errExit.c src/semaphore.c src/report.c src/pipeline.c
SUBMIT_SRCS=src/errExit.c src/semaphore.c src/submit.c

PIPELINE_OBJS=$(PIPELINE_SRCS:.c=.o)
SUBMIT_OBJS=$(SUBMIT_SRCS:.c=.o)
SRCS=src/errExit.c src/semaphore.c src/report.c src/pipeline.c src/submit.c
OBJS=$(SRCS:.c=.o)

all: pipeline submit

pipeline: $(PIPELINE_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

submit: $(SUBMIT_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

.c.o:
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean

clean:
	@rm -f src/*.o pipeline submit
	@echo "Removed object files and executables..."
